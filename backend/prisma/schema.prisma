generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String    @id @default(uuid())
  name       String
  telegramId String    @unique
  role       RoleType
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  bars       UserBar[]
}

model Bar {
  id          String       @id @default(uuid())
  name        String
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  expenses    Expense[]
  barProducts BarProduct[]
  purchases   Purchase[]
  revenues    Revenue[]
  users       UserBar[]
}

model UserBar {
  id     String @id @default(uuid())
  userId String
  barId  String
  bar    Bar    @relation(fields: [barId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, barId])
}

model Category {
  id       String      @id @default(uuid())
  name     String
  type     ProductType @default(PRODUCT)
  products Product[]
}

model Product {
  id           String       @id @default(uuid())
  name         String
  barcode      String?      @unique
  type         ProductType  @default(PRODUCT)
  costPrice    Float
  defaultPrice Float?       // Цена по умолчанию для всех баров
  categoryId   String
  imageUrl     String?
  description  String?
  createdAt    DateTime     @default(now())
  category     Category     @relation(fields: [categoryId], references: [id])
  barProducts  BarProduct[]
}

model BarProduct {
  id        String   @id @default(uuid())
  barId     String
  productId String
  price     Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  bar       Bar      @relation(fields: [barId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([barId, productId])
}

model Revenue {
  id        String   @id @default(uuid())
  barId     String
  date      DateTime
  cash      Float
  card      Float
  createdAt DateTime @default(now())
  bar       Bar      @relation(fields: [barId], references: [id])

  @@unique([barId, date])
}

model Expense {
  id          String   @id @default(uuid())
  barId       String
  amount      Float
  description String
  createdAt   DateTime @default(now())
  bar         Bar      @relation(fields: [barId], references: [id])
}

model Supplier {
  id        String     @id @default(uuid())
  name      String
  purchases Purchase[]
}

model Purchase {
  id          String         @id @default(uuid())
  barId       String
  supplierId  String?
  totalAmount Float
  createdAt   DateTime       @default(now())
  bar         Bar            @relation(fields: [barId], references: [id])
  supplier    Supplier?      @relation(fields: [supplierId], references: [id])
  items       PurchaseItem[]
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  name       String
  amount     Float
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())
}

enum RoleType {
  ADMIN
  MANAGER
  WORKER
}

enum ProductType {
  PRODUCT
  SPORT_PIT
  FOOD
}
