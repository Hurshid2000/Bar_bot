generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String      @id @default(uuid())
  name       String
  telegramId String      @unique
  role       RoleType
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  bars       UserBar[]
  orders     Order[]
  arrivals   Arrival[]
  pushTokens PushToken[]
  inventories Inventory[]
}

model Bar {
  id          String       @id @default(uuid())
  name        String
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  expenses    Expense[]
  barProducts BarProduct[]
  purchases   Purchase[]
  revenues    Revenue[]
  users       UserBar[]
  orders      Order[]
  arrivals    Arrival[]
  inventories Inventory[]
}

model UserBar {
  id     String @id @default(uuid())
  userId String
  barId  String
  bar    Bar    @relation(fields: [barId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, barId])
}

model Category {
  id       String      @id @default(uuid())
  name     String
  type     ProductType @default(PRODUCT)
  products Product[]
}

model Product {
  id           String       @id @default(uuid())
  name         String
  barcode      String?      @unique
  type         ProductType  @default(PRODUCT)
  costPrice    Float
  defaultPrice Float?       // Цена по умолчанию для всех баров
  categoryId   String
  imageUrl     String?
  description  String?
  createdAt    DateTime     @default(now())
  category     Category     @relation(fields: [categoryId], references: [id])
  barProducts  BarProduct[]
  orderItems   OrderItem[]
  arrivalItems ArrivalItem[]
  inventoryItems InventoryItem[]
}

model BarProduct {
  id        String   @id @default(uuid())
  barId     String
  productId String
  price     Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  bar       Bar      @relation(fields: [barId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([barId, productId])
}

model Revenue {
  id        String   @id @default(uuid())
  barId     String
  date      DateTime
  cash      Float
  card      Float
  createdAt DateTime @default(now())
  bar       Bar      @relation(fields: [barId], references: [id])

  @@unique([barId, date])
}

model Expense {
  id          String   @id @default(uuid())
  barId       String
  amount      Float
  description String
  createdAt   DateTime @default(now())
  bar         Bar      @relation(fields: [barId], references: [id])
}

model Supplier {
  id        String     @id @default(uuid())
  name      String
  purchases Purchase[]
}

model Purchase {
  id          String         @id @default(uuid())
  barId       String
  supplierId  String?
  totalAmount Float
  createdAt   DateTime       @default(now())
  bar         Bar            @relation(fields: [barId], references: [id])
  supplier    Supplier?      @relation(fields: [supplierId], references: [id])
  items       PurchaseItem[]
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  name       String
  amount     Float
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())
}

enum RoleType {
  ADMIN
  MANAGER
  WORKER
}

enum ProductType {
  PRODUCT
  SPORT_PIT
  FOOD
}

enum OrderStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ArrivalType {
  ARRIVAL
  WRITE_OFF
}

model Order {
  id        String      @id @default(uuid())
  barId     String
  userId    String
  status    OrderStatus @default(NEW)
  comment   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  bar       Bar         @relation(fields: [barId], references: [id])
  user      User        @relation(fields: [userId], references: [id])
  items     OrderItem[]
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float    // Цена на момент заказа
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
}

model Arrival {
  id        String       @id @default(uuid())
  barId     String
  userId    String
  type      ArrivalType  @default(ARRIVAL)
  comment   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  bar       Bar          @relation(fields: [barId], references: [id])
  user      User         @relation(fields: [userId], references: [id])
  items     ArrivalItem[]
}

model ArrivalItem {
  id        String   @id @default(uuid())
  arrivalId String
  productId String
  quantity  Int
  price     Float    // Цена на момент прихода/списания
  arrival   Arrival  @relation(fields: [arrivalId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  deviceInfo String? // Опциональная информация об устройстве
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Inventory {
  id        String          @id @default(uuid())
  barId     String
  userId    String
  comment   String?
  totalAmount Float         // Общая сумма инвентаризации
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  bar       Bar             @relation(fields: [barId], references: [id])
  user      User            @relation(fields: [userId], references: [id])
  items     InventoryItem[]
}

model InventoryItem {
  id           String    @id @default(uuid())
  inventoryId String
  productId    String
  quantity     Int       // Количество товара
  price        Float     // Цена на момент инвентаризации
  totalAmount  Float     // Сумма: quantity * price
  inventory    Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id])
}
