generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String    @id @default(uuid())
  name       String
  telegramId String    @unique
  role       RoleType
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  bars       UserBar[]
}

model Bar {
  id        String     @id @default(uuid())
  name      String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  expenses  Expense[]
  products  Product[]
  purchases Purchase[]
  revenues  Revenue[]
  users     UserBar[]
}

model UserBar {
  id     String @id @default(uuid())
  userId String
  barId  String
  bar    Bar    @relation(fields: [barId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, barId])
}

model Category {
  id       String    @id @default(uuid())
  name     String
  products Product[]
}

model Product {
  id         String      @id @default(uuid())
  name       String
  barcode    String?
  type       ProductType @default(PRODUCT)
  costPrice  Float
  price      Float
  barId      String
  categoryId String
  createdAt  DateTime    @default(now())
  bar        Bar         @relation(fields: [barId], references: [id])
  category   Category    @relation(fields: [categoryId], references: [id])
}

model Revenue {
  id        String   @id @default(uuid())
  barId     String
  date      DateTime
  cash      Float
  card      Float
  createdAt DateTime @default(now())
  bar       Bar      @relation(fields: [barId], references: [id])

  @@unique([barId, date])
}

model Expense {
  id          String   @id @default(uuid())
  barId       String
  amount      Float
  description String
  createdAt   DateTime @default(now())
  bar         Bar      @relation(fields: [barId], references: [id])
}

model Supplier {
  id        String     @id @default(uuid())
  name      String
  purchases Purchase[]
}

model Purchase {
  id          String         @id @default(uuid())
  barId       String
  supplierId  String?
  totalAmount Float
  createdAt   DateTime       @default(now())
  bar         Bar            @relation(fields: [barId], references: [id])
  supplier    Supplier?      @relation(fields: [supplierId], references: [id])
  items       PurchaseItem[]
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  name       String
  amount     Float
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())
}

enum RoleType {
  ADMIN
  MANAGER
  WORKER
}

enum ProductType {
  PRODUCT
  SPORT_PIT
}
